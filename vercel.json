{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "assets/**",
          "data/**",
          "scripts/**",
          "site/**",
          "*.html",
          "*.png",
          "*.jpg",
          "*.jpeg",
          "*.webp",
          "*.ico",
          "*.json",
          "*.webmanifest"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
